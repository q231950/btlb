    "Recommend_App_Thanks_Alert_Later_Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natürlich, du bist gerade sehr beschäftigt. Studium, Arbeit und so. Empfehle BTLB, wann immer es dir beliebt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of course, you're busy right now. Reading books? You may recommend BTLB at any time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien sûr, vous êtes occupé en ce moment. Vous lisez des livres ? Vous pouvez recommander BTLB à tout moment."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звісно, ви зараз зайняті. Читаєте книги? Ви можете рекомендувати BTLB у будь-який час."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por supuesto, estás ocupado ahora. ¿Leyendo libros? Puedes recomendar BTLB en cualquier momento."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabii ki, şu anda meşgulsün. Kitap mı okuyorsun? BTLB'yi istediğin zaman tavsiye edebilirsin."
          }
        }
      }
    },
