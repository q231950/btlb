    "account creation success message %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bibliothekskonto **%@** wurde erfolgreich hinzugefügt. Du kannst dieses Konto jederzeit in der _Einstellungen Sektion_ bearbeiten und dort auch weitere hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The library account **%@** has successfully been added. You can edit this account or add additional ones in the _Settings Section_ of the app at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de biblioteca **%@** se ha agregado exitosamente. Puedes editar esta cuenta o agregar otras adicionales en la _Sección de Configuración_ de la aplicación en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte de bibliothèque **%@** a été ajouté avec succès. Vous pouvez modifier ce compte ou en ajouter d'autres dans la _Section Paramètres_ de l'application à tout moment."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%@** kütüphane hesabı başarıyla eklendi. Bu hesabı düzenleyebilir veya uygulamanın _Ayarlar Bölümü_'nden istediğiniz zaman yeni hesaplar ekleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бібліотечний обліковий запис **%@** успішно додано. Ви можете редагувати цей обліковий запис або додати додаткові в _розділі налаштувань_ додатку в будь-який час."
          }
        }
      }
    },
