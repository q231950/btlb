          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe notificaciones sobre actualizaciones automáticas de cuentas que ocurrieron mientras la aplicación estaba en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez des notifications concernant les mises à jour automatiques de compte qui se sont produites pendant que l'application était en arrière-plan."
          }
