    "latest account update date never" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast deine Konten noch nie manuell aktualisiert. Ziehe die Entleihungen oder die Gebühren Ansicht nach unten um eine Aktualisierung anzustoßen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have never updated your accounts manually. Pull to refresh in the loans or the charges section of the app to trigger an update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca has actualizado tus cuentas manualmente. Desliza hacia abajo en la sección de préstamos o cargos de la aplicación para activar una actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez jamais mis à jour vos comptes manuellement. Tirez pour actualiser dans la section emprunts ou frais de l'application pour déclencher une mise à jour."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesaplarınızı hiç manuel olarak güncellememişsiniz. Güncelleme başlatmak için uygulamadaki ödünç alma veya ücretler bölümünde aşağı çekin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви ніколи не оновлювали свої облікові записи вручну. Потягніть вниз у розділі позик або зборів додатка, щоб запустити оновлення."
          }
        }
      }
    },
    "LATEST_ACCOUNT_UPDATE_AUTOMATIC_NEVER" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Konten wurden noch nie im Hintergrund aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your accounts have never been updated in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cuentas nunca han sido actualizadas en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos comptes n'ont jamais été mis à jour en arrière-plan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesaplarınız arka planda hiç güncellenmemiş."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші облікові записи ніколи не оновлювалися у фоновому режимі."
          }
        }
      }
    },
    "LIBRARIES_TEXT" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derzeit werden die Bibliotheken der Stiftung Hamburger Öffentliche Bücherhallen und weitere im Gemeinsamen Bibliotheksverbundes (GBV) unterstützt. Bitte komme in Kontakt falls du deine Bibliothek ebenfalls mit BTLB nutzen möchtest und diese nicht gelistet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The libraries of Stiftung Hamburger Öffentliche Bücherhallen and many of the Common Library Network (GBV) are supported at this moment. Please get in touch if you'd like your library to be added."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualmente se admiten las bibliotecas de la Fundación de Bibliotecas Públicas de Hamburgo y muchas de la Red Común de Bibliotecas (GBV). Póngase en contacto si desea que se agregue su biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bibliothèques de la Fondation des bibliothèques publiques de Hambourg et beaucoup du Réseau commun des bibliothèques (GBV) sont supportées en ce moment. Veuillez nous contacter si vous souhaitez que votre bibliothèque soit ajoutée."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda Hamburg Kamu Kütüphaneleri Vakfı ve Ortak Kütüphane Ağı'nın (GBV) birçok kütüphanesi desteklenmektedir. Kütüphanenizin eklenmesini istiyorsanız lütfen iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наразі підтримуються бібліотеки Фонду громадських бібліотек Гамбурга та багато бібліотек Спільної бібліотечної мережі (GBV). Будь ласка, зв'яжіться з нами, якщо ви хочете додати свою бібліотеку."
          }
        }
      }
    },
