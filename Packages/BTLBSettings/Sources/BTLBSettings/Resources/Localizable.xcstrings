    "Open Source" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🦄 Open Source"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🦄 Open Source"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🦄 Open Source"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🦄 Açık Kaynak"
          }
        },
        "uk" : {
          "stringUnit" : {
