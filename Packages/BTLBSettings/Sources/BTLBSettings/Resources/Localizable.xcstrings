    "NOTIFICATION_DESCRIPTION_ACCOUNT_UPDATE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte eine Benachrichtigung bei automatischen Aktualisierungen der Konten während sich die App im Hintergrund befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
